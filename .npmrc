# Configuração lida pelo pnpm (ADR-0024).
#
# Garante que toda nova dependência adicionada via `pnpm add` será salva
# com versão exata (sem ^ ou ~). Equivalente a --save-exact por padrão.
save-exact=true
# Bloqueia a instalação quando a versão do Node/pnpm não atende ao campo
# `engines` do package.json (Node 24 a partir da 24.22.2, pnpm 10+). Sem isso,
# o pnpm apenas emitiria um aviso em vez de falhar.
engine-strict=true
