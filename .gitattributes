# Normaliza quebras de linha: o repositório sempre armazena com LF.
# Evita conflitos de line ending entre Windows (CRLF) e Unix (LF).
* text=auto eol=lf

# Arquivos binários não devem ser normalizados.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
