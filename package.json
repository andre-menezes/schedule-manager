{
  "name": "schedule-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "pnpm dev",
    "dev": "vite --open",
    "stg": "vite --mode staging",
    "typecheck": "vue-tsc -b",
    "build:only:dev": "vite build --mode development",
    "build:only:stg": "vite build --mode staging",
    "build:only:prod": "vite build",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint src e2e mock playwright.config.ts",
    "lint:fix": "eslint src e2e mock playwright.config.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm test && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@sentry/vue": "11.10.0",
    "@tanstack/vue-query": "5.105.1",
    "material-symbols": "0.48.2",
    "ofetch": "1.5.1",
    "pinia": "4.1.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0",
    "vuetify": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "lint-staged": {
    "{src,e2e,mock}/**/*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,scss,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
